{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/conselho/schemas/agent-result.v2.schema.json",
  "title": "agent-result-v2",
  "description": "Retorno estruturado de agent worker; output deve ser referenciado e validado.",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_version": {
      "const": "agent.result.v2"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^A(0[1-9]|1[0-9]|2[0-3])$"
    },
    "case_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "blocked",
        "failed",
        "timed_out"
      ]
    },
    "artifact_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifact_type": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "context_manifest_id": {
      "type": "string",
      "format": "uuid"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_type": {
            "type": "string",
            "enum": [
              "user",
              "financial",
              "official_law",
              "market",
              "agent",
              "document"
            ]
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "valid_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "source_type",
          "observed_at"
        ],
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "model_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "cost_estimate_usd": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "input_tokens",
        "output_tokens"
      ],
      "additionalProperties": false
    },
    "usage_state": {
      "type": "string",
      "enum": [
        "measured",
        "partial",
        "unavailable"
      ]
    }
  },
  "required": [
    "run_id",
    "schema_version",
    "agent_id",
    "case_id",
    "status",
    "artifact_id",
    "artifact_type",
    "context_manifest_id",
    "evidence",
    "assumptions",
    "unknowns",
    "error_code",
    "started_at",
    "finished_at",
    "usage",
    "usage_state"
  ],
  "additionalProperties": false
}
