{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/conselho/schemas/event-envelope.schema.json",
  "title": "event-envelope",
  "description": "Envelope imutavel do event journal; payload validado por event_type.",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_version": {
      "const": "event.v1"
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "classification": {
      "type": "string",
      "enum": [
        "public",
        "aggregated",
        "restricted",
        "secret",
        "internal"
      ]
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    },
    "payload_schema_version": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "event_id",
    "schema_version",
    "event_type",
    "user_id",
    "correlation_id",
    "idempotency_key",
    "sequence",
    "occurred_at",
    "recorded_at",
    "classification",
    "actor",
    "payload",
    "payload_schema_version"
  ],
  "additionalProperties": false
}
