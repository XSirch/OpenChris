# Copie para .env.vps (ignorado pelo Git) e gere valores exclusivos.
PUBLIC_BASE_URL=https://conselho.example.com
APP_PASSWORD=SUBSTITUA_POR_UMA_SENHA_ALEATORIA_DE_32_CARACTERES
POSTGRES_PASSWORD=SUBSTITUA_POR_UM_SEGREDO_HEXADECIMAL_ALEATORIO
# Ative cada integração somente depois de preencher e validar suas credenciais.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_ALLOWED_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
PLUGGY_ENABLED=false
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_WEBHOOK_SECRET=
PLUGGY_SYNC_INTERVAL=6h
# Runner privado com autenticação própria na VPS.
CODEX_ENABLED=false
# Docker Compose usa http://conselho-codex:8081. A URL abaixo é para o app no EasyPanel.
CODEX_RUNNER_URL=http://conselho-codex-internal:8081
CODEX_RUNNER_TOKEN=
CODEX_AUTH_KEY=
CODEX_DAILY_LIMIT=30
# Ative depois da verificação real do runner e das fontes públicas.
AUTONOMY_ENABLED=false
AUTONOMY_DAILY_LIMIT=20
# Webhooks derivados de PUBLIC_BASE_URL; não definir outra origem.
# Segredos de webhook precisam ter pelo menos 32 caracteres.
