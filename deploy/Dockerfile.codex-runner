FROM alpine:3.22@sha256:2e0b81d60597f449baa56dc25d355367869d2dca4cd57e866f1e2b52af3eb55f AS cli
ADD --checksum=sha256:beb339e8ecd9ba057a6bb2dc81ad8ca474812edfbf0fc5056ca818797648dde4 https://github.com/openai/codex/releases/download/rust-v0.163.0/codex-x86_64-unknown-linux-musl.tar.gz /tmp/codex.tar.gz
RUN tar -xzf /tmp/codex.tar.gz -C /tmp && mv /tmp/codex-x86_64-unknown-linux-musl /codex && chmod 0555 /codex

FROM alpine:3.22@sha256:2e0b81d60597f449baa56dc25d355367869d2dca4cd57e866f1e2b52af3eb55f
RUN apk add --no-cache ca-certificates && addgroup -g 10001 conselho && adduser -D -u 10001 -G conselho conselho && mkdir /state && chown 10001:10001 /state
COPY --from=cli /codex /usr/local/bin/codex
COPY --chmod=0555 codex-runner /app/codex-runner
USER 10001:10001
WORKDIR /tmp
EXPOSE 8081
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s CMD ["/app/codex-runner", "health"]
ENTRYPOINT ["/app/codex-runner"]
