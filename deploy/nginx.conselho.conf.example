# Incluir dentro do server HTTPS existente do domínio autorizado.
# Certificado, DNS e instalação do proxy dependem do ambiente da VPS.
location / {
    proxy_pass http://127.0.0.1:18480;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 90s;
}

location ~ ^/api/(office|finance)/events$ {
    proxy_pass http://127.0.0.1:18480;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 90s;
}
